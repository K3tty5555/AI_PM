#!/usr/bin/env bash
# AI_PM 提交前护栏（路径过滤：只在本次提交动了相关文件时才跑对应检查）。
# 新增检查往下追加一段同样的「过滤 → 跑」即可。
# 启用方式（每个 clone 一次性）：git config core.hooksPath .githooks
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# 本次已暂存（staged）的文件，含改名（ACMR）
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# ── 检查 1：doctype 骨架检测回归 ──
# 触发条件：动了 check-prd-skeleton.sh 本身，或动了它的回归 fixture。
# 注：本检查只验「参考检测脚本 + fixture 标准答案」是否一致；
#     不验 skill 里 pm-agent 的真实 doctype 判定（那是模型在环的 Mode C，无法做成确定性钩子）。
if echo "$staged" | grep -qE '^(scripts/check-prd-skeleton\.sh$|tests/fixtures/prd-doctype/)'; then
  echo "🔎 pre-commit: 改动涉及 doctype 骨架检测，跑 fixture 回归…"
  if ! bash "$ROOT/scripts/check-prd-skeleton.sh"; then
    echo ""
    echo "❌ check-prd-skeleton 回归未过——上面有 fixture 判定不符，先修好再提交。"
    exit 1
  fi
fi

# ── 检查 2：skill 引用存在性（B3 gate 接入，2026-07-03）──
# 触发条件：动了 .claude/skills/ 或 .claude/agents/ 下任何 md（skill 正文引用最易随改动断链）。
# 检查本体 0.1s 级，零干扰。
if echo "$staged" | grep -qE '^\.claude/(skills|agents)/.*\.md$'; then
  echo "🔎 pre-commit: 改动涉及 skill/agent，跑引用存在性检查…"
  if ! python3 "$ROOT/scripts/check-skill-ref-exists.py"; then
    echo ""
    echo "❌ skill 引用存在性未过——有引用指向不存在的文件，先修好再提交。"
    exit 1
  fi
fi

# ── 检查 3：规则漂移 + 骨架单源（合并计划波0B，2026-07-12）──
# 触发条件：动了判断卡 / pm-agent / 三大 PRD 模板 / 各校验器——本仓最在意的漂移面。
if echo "$staged" | grep -qE '(pm-judgment-card\.md|prototype-judgment-card\.md|pm-agent\.md|prototype-agent\.md|templates/prd-styles/default/|check-rule-drift\.sh|check-skeleton-rule-drift\.sh|check-prototype-regex-drift\.py|phase-5-prd\.md|ai-pm-driver/SKILL\.md)'; then
  echo "🔎 pre-commit: 改动涉及规则面，跑规则漂移 + 骨架单源检查…"
  if ! bash "$ROOT/scripts/check-rule-drift.sh"; then
    echo "❌ 规则漂移检查未过——多副本口径不一致，先对齐再提交。"; exit 1
  fi
  if ! bash "$ROOT/scripts/check-skeleton-rule-drift.sh"; then
    echo "❌ 骨架单源检查未过。"; exit 1
  fi
fi

exit 0
