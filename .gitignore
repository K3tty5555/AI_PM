# =============================================================================
# AI_PM Project - Git Ignore Configuration
# =============================================================================

# Git worktrees
.worktrees/

# Subagent-driven development 工作区（ledger / brief / review package，纯临时）
.superpowers/

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# IDE & Editor Files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp
.cache/
.turbo/
.vite/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# AI_PM Specific - Generated Content
# -----------------------------------------------------------------------------

# Project outputs (may contain sensitive corporate data)
# Includes output/projects/ and output/strategy-sandbox/ private user work.
output/

# Presentation files (local use only)
AI_PM_提效分享.html

# Documentation build output
.docs/

# Documentation directory (含真实业务背景、对接人、试点学校等私有信息)
# 包括 plans/ 和顶层设计文档；后续在 docs/ 下新增的文件也会自动 ignore
/docs/

# AI shared local context copies
# Keep bridge docs/scripts versioned, but do not upload local memory snapshots,
# pending memory handoffs, context content, or AI conversation records.
.ai-shared/review-exchange/*
!.ai-shared/review-exchange/README.md
.ai-shared/memory-snapshots/
.ai-shared/conversations/
.ai-shared/pending-memory/
# context/ 内容文件一律仅本机（铁律），只放行 README.md
.ai-shared/context/*
!.ai-shared/context/README.md
.ai-shared/memory-index.md
.ai-shared/agent-index.md
.ai-shared/skill-index.md
# avatars/ 群聊头像（图片内容仅本机，只放行 README.md）
.ai-shared/avatars/*
!.ai-shared/avatars/README.md

# Playwright
.playwright/
.playwright-mcp/
.claude/**/.playwright-cli/
.claude/projects/
.claude/settings.local.json
# 本地专属 / 项目专属 skill：含内部域名 + 凭证逻辑，只在本机用，不入库不推 GitHub
.claude/skills/xfchat-wiki/
.claude/skills/tpd_cli/
# D2C 运行时目录：config.json 存 MasterGo PAT 明文，dsl_raw.json 含真实设计稿内容
.d2c/
# 内网专属依赖（MasterGo MCP 等）：随项目走、不入库，与 .claude/skills/xfchat-wiki 同待遇
# 安装方式记在本机 docs/ 下的设计文档里，不写进版本库（内网 registry 域名不得入库）
vendor/
# MasterGo D2C（内网 npm 源分发 + mg_ 凭证 + iflytek 域名），同上只在本机
.claude/skills/d2c/
.claude/skills/d2c-analyze/
.claude/skills/d2c-codegen/
.claude/skills/d2c-fetch/
.claude/skills/d2c-setup/
# Codex 本地状态默认不入库，仅共享 AI_PM 项目级 hook 入口。
.codex/*
!.codex/hooks.json

# Test reports
coverage/
.nyc_output/
playwright-report/
test-results/

# -----------------------------------------------------------------------------
# AI_PM Specific - Templates
# -----------------------------------------------------------------------------

# Built-in templates are versioned. Keep local uploads/private overrides out.
templates/**/local/
templates/**/private/
templates/**/uploads/
templates/**/.cache/

# 个人知识库内容（含真实业务洞察、客户访谈、PRD 引用等私有信息）
# 保留 README.md（目录说明）和 .gitkeep（目录骨架）
templates/knowledge-base/decisions/*
templates/knowledge-base/insights/*
templates/knowledge-base/metrics/*
templates/knowledge-base/patterns/*
templates/knowledge-base/pitfalls/*
templates/knowledge-base/playbooks/*
templates/knowledge-base/chains/*
!templates/knowledge-base/**/.gitkeep

# 个人 PRD 风格 profile（persona analyze 产出，含真实 PRD 原句 sample_sentences）+ 当前生效风格
# 团队标准 default / enterprise-standard 仍入库（已脱敏），个人微调 profile 一律本机
templates/prd-styles/.active-persona
templates/prd-styles/*/
!templates/prd-styles/default/
!templates/prd-styles/enterprise-standard/

# 个人 persona 本机备份（声音画像 / 写作风格等，含真实语料）
# memory/ 是 live 权威源，此目录仅作仓库侧备份；只放行 README.md 和 .gitkeep
templates/persona/*
!templates/persona/README.md
!templates/persona/.gitkeep

# 分享前内部名清单（含真实公司/产品/人名，仅本机；模板 .example 保留追踪）
scripts/.share-denylist
scripts/.metrics-dict.md


