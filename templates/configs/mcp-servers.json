{
  "$comment": "AI_PM 遥控工具唯一配置来源。版本、镜像、启动参数与安卓下载指纹都在这里锁定。",
  "schema_version": 1,
  "mirrors": {
    "npm_registry": "https://registry.npmmirror.com",
    "pypi_index": "https://mirrors.aliyun.com/pypi/simple/",
    "uv_python_mirror": "https://registry.npmmirror.com/-/binary/python-build-standalone/"
  },
  "android_platform_tools": {
    "version": "37.0.1",
    "license_url": "https://developer.android.com/studio/terms",
    "channels": [
      "https://googledownloads.cn/android/repository/",
      "https://mirrors.cloud.tencent.com/AndroidSDK/"
    ],
    "assets": {
      "darwin": {
        "file": "platform-tools_r37.0.1-darwin.zip",
        "sha1": "6ae73f4de6452dc57e62ec02b68eed92a4c21661"
      },
      "windows": {
        "file": "platform-tools_r37.0.1-win.zip",
        "sha1": "e03e78b1d80b396f1c3358e31251cb31740e1110"
      }
    },
    "package_managers": {
      "windows": "winget install --id Google.PlatformTools -e",
      "mac": "brew install --cask android-platform-tools"
    }
  },
  "servers": {
    "playwright": {
      "target": "web",
      "version": "0.0.83",
      "npm_package": "@playwright/mcp",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@{version}", "--browser", "{browser}"],
      "env": {"npm_config_registry": "{npm_registry}"}
    },
    "mobile-mcp": {
      "target": "android",
      "version": "1.0.11",
      "npm_package": "@mobilenext/mobile-mcp",
      "command": "node",
      "args": ["{tools}/npm/node_modules/@mobilenext/mobile-mcp/lib/index.js"],
      "env": {"ANDROID_HOME": "{android_home}", "MOBILEMCP_DISABLE_TELEMETRY": "1"}
    },
    "windows-mcp": {
      "target": "windows-app",
      "version": "0.8.8",
      "pypi_package": "windows-mcp",
      "command": "{windows_mcp}",
      "args": ["serve", "--exclude-tools", "PowerShell,Registry"],
      "env": {"ANONYMIZED_TELEMETRY": "false"}
    }
  }
}
