{
  "$comment": "AI_PM 六种用户工作模式与底层 capability 的单一机读映射。mode 是无状态意图门面，不写 _status.last_phase；phase_effect 仅声明能力对现有生命周期状态的影响。",
  "schema_version": 1,
  "modes": [
    {
      "id": "explore",
      "label": "探索研究",
      "purpose": "确认问题、用户、数据和市场事实",
      "capabilities": ["analyze", "research", "interview", "data", "gap-research"],
      "exit_condition": "关键未知已显式，可进入决策或继续取证"
    },
    {
      "id": "decide",
      "label": "决策分析",
      "purpose": "判断要不要做、先做什么、选择哪条路线",
      "capabilities": ["priority", "strategy", "strategy-verify"],
      "exit_condition": "待拍板项已收敛，范围边界可进入 PRD"
    },
    {
      "id": "prd",
      "label": "PRD",
      "purpose": "定义本期做什么、不做什么以及如何验收",
      "capabilities": ["prd", "story", "persona", "humanizer", "reconcile"],
      "exit_condition": "范围、规则、影响、指标和责任边界可评审"
    },
    {
      "id": "prototype",
      "label": "原型",
      "purpose": "把已确认需求转成忠于现状和端别的可评审交互",
      "capabilities": ["prototype", "frontend-design", "design-spec", "humanizer", "reconcile"],
      "exit_condition": "关键路径与状态齐全，端别差异有证据"
    },
    {
      "id": "review",
      "label": "评审验收",
      "purpose": "检查文档质量并核实实现是否符合约定",
      "capabilities": ["driver", "review", "acceptance", "plan-review", "reconcile"],
      "exit_condition": "问题有证据和归属，真人保留最终判定权"
    },
    {
      "id": "operate",
      "label": "运营复盘",
      "purpose": "回收交付效果、项目经验和后续动作",
      "capabilities": ["data", "weekly", "retrospective", "impact", "knowledge", "sharing", "humanizer", "reconcile"],
      "exit_condition": "形成继续、调整、停止或继续观察的结论并更新事实"
    }
  ],
  "workspace_commands": ["init", "list", "switch", "continue", "new", "import", "reset", "delete", "config", "doctor", "refresh"],
  "capabilities": [
