{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipm://status.schema.v1",
  "title": "AI_PM 项目 _status.json v1（合并计划波3 · 最小契约）",
  "description": "核心字段机读契约。additionalProperties=true：历史自由字段全部保留、读方忽略未知——迁移只增不删。",
  "type": "object",
  "required": ["schema_version", "project", "lifecycle", "updated"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "enum": ["active", "paused", "completed", "archived", "reference"],
      "description": "active=在途；paused=暂停待续；completed=已交付未归档；archived=历史归档（不参与在途报表与当前产物解析）；reference=纯资料库（如历史 PRD 归档）"
    },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "phases": { "type": "object", "description": "阶段完成映射，键见 templates/configs/workflow-phases.json" },
    "last_phase": { "type": "string" },
    "active_prd": {
      "type": "string",
      "pattern": "^(?!05-prd/).+\\.md$",
      "description": "当前 PRD 相对 05-prd/ 的路径（禁再带 05-prd/ 前缀；允许子目录如 归档/x.md——resolver join 语义）；多版本并存时的唯一机读消歧源"
    },
    "baseline": {
      "type": "object",
      "description": "事实基线指针；正文与人工可读 delta 仍在项目文件，status 只登记机读 manifest 及最近验证水位",
      "properties": {
        "manifest": {"type": "string", "const": "01-baseline-manifest.json"},
        "verified_at": {"type": "string", "minLength": 10},
        "content_hash": {"type": "string"}
      },
      "required": ["manifest"]
    },
    "artifacts": {
      "type": "array",
      "description": "项目产物与依赖的最小注册表；mode 不入表，producer_capability 记录生产者。列全影响只承诺本数组覆盖范围，未登记内容必须报告 coverage gap。",
      "items": {
        "type": "object",
        "required": ["artifact_id", "type", "path_or_remote_id", "authoritative_source", "version_or_hash", "producer_capability", "dependencies", "owner", "status", "last_verified_at"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "type": {"enum": ["baseline", "decision", "prd", "prototype", "review", "acceptance", "metric", "release-doc", "cloud-doc", "memory", "other"]},
          "path_or_remote_id": {"type": "string", "minLength": 1},
          "authoritative_source": {"enum": ["local-primary", "cloud-primary", "mixed", "external-reference"]},
          "version_or_hash": {"type": "string"},
          "producer_capability": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "owner": {"enum": ["ai", "human", "shared", "external"]},
          "status": {"enum": ["current", "stale", "archived", "missing"]},
          "last_verified_at": {"type": "string"},
          "ownership_rules": {
            "type": "array",
            "description": "mixed 产物的候选区域归属；现有云文档适配器仍是整篇级，规则存在不等于已支持块级 apply",
            "items": {
              "type": "object",
              "required": ["selector", "owner", "conflict_policy"],
              "properties": {
                "selector": {"type": "string"},
                "owner": {"enum": ["ai", "human", "shared"]},
                "conflict_policy": {"enum": ["block", "prefer-local", "prefer-cloud", "manual"]}
              }
            }
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "description": "两轴并存（二轮复验 5.1：schema 与生产器曾语义分裂）：type=责任主体（human/ai/external，拿不准不猜可缺省），kind=工作流状态（whats-next --set 写入）；等外部 可安全映射 type=external",
      "properties": {
        "type": { "enum": ["human", "ai", "external"] },
        "kind": { "enum": ["待续", "等外部", "待办", "断点"] },
        "text": { "type": "string", "minLength": 1 },
        "due": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "required": ["text"]
    },
    "cloud_docs": {
      "type": "object",
      "description": "云文档正本登记（key=PRD 文件名），字段见 phase-5 push 登记约定"
    }
  },
  "additionalProperties": true
}
