#!/usr/bin/env bash
set -euo pipefail

BUNDLE=""
ROOT_DIR=""
BUILD=""
POLICY=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --bundle) BUNDLE="$2"; shift 2 ;;
    --root) ROOT_DIR="$2"; shift 2 ;;
    --build) BUILD="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

case "$ROOT_DIR" in /*) ;; *) echo "root must be absolute" >&2; exit 2 ;; esac
case "$BUILD" in b-[a-z0-9_-]*) ;; *) echo "invalid build" >&2; exit 2 ;; esac
[ -f "$BUNDLE" ] || { echo "bundle not found" >&2; exit 1; }

mkdir -p "$ROOT_DIR/.incoming" "$ROOT_DIR/.staging"
stage="$ROOT_DIR/.staging/$BUILD.$$"
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage"

if tar -tzf "$BUNDLE" | awk 'BEGIN{bad=0} { if ($0 ~ /^\// || $0 ~ /(^|\/)\.\.(\/|$)/) bad=1 } END{exit bad}'; then :; else
  echo "bundle contains an unsafe path" >&2; exit 1
fi
tar -xzf "$BUNDLE" -C "$stage"
[ -d "$stage/$BUILD" ] || { echo "bundle build directory missing" >&2; exit 1; }
[ "$(find "$stage/$BUILD" -type f | wc -l | tr -d ' ')" -gt 0 ] || { echo "bundle is empty" >&2; exit 1; }

target="$ROOT_DIR/$BUILD"
[ ! -e "$target" ] || { echo "build already exists: $target" >&2; exit 1; }
mv "$stage/$BUILD" "$target"
sudo chgrp -R aipm "$target"
sudo chmod -R g+rwX "$target"

if [ -n "$POLICY" ]; then
  [ -f "$POLICY" ] || { echo "policy not found" >&2; exit 1; }
  policy_dir="/etc/aipm"
  sudo mkdir -p "$policy_dir"
  sudo python3 - "$POLICY" "$policy_dir/remote-feedback-policy.json" <<'PY'
import grp, json, os, pathlib, sys, tempfile
incoming = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
target = pathlib.Path(sys.argv[2])
current = {'schema_version': 1, 'builds': {}}
if target.exists():
    current = json.loads(target.read_text(encoding='utf-8'))
if incoming.get('schema_version') != 1 or not isinstance(incoming.get('builds'), dict):
    raise SystemExit('invalid incoming policy')
if current.get('schema_version') != 1 or not isinstance(current.get('builds'), dict):
    raise SystemExit('invalid existing policy')
current['builds'].update(incoming['builds'])
target.parent.mkdir(parents=True, exist_ok=True)
fd, temp = tempfile.mkstemp(prefix='.remote-feedback-policy.', dir=str(target.parent))
os.close(fd)
pathlib.Path(temp).write_text(json.dumps(current, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
os.chmod(temp, 0o640)
os.chown(temp, 0, grp.getgrnam('aipm').gr_gid)
os.replace(temp, target)
PY
  sudo systemctl reload-or-restart aipm-remote-feedback.service
fi

rm -f "$BUNDLE"
echo "INSTALLED: $target"
