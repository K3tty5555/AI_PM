[Unit]
Description=AI_PM remote prototype feedback receiver
After=network.target

[Service]
Type=simple
User=aipm
Group=aipm
WorkingDirectory=/srv/aipm
ExecStart=/usr/bin/python3 /opt/aipm/aipm_remote_feedback.py --root /srv/aipm --policy /etc/aipm/remote-feedback-policy.json --host 127.0.0.1 --port 8876
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/aipm
ReadOnlyPaths=/etc/aipm/remote-feedback-policy.json /opt/aipm/aipm_remote_feedback.py /opt/aipm/aipm_prototype_collab.py

[Install]
WantedBy=multi-user.target
